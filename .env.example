# Solana cluster RPC endpoint used by the SDK and CLI.
# Examples:
#   Devnet:  https://api.devnet.solana.com
#   Mainnet: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Path to the local keypair used for signing.
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# Anchor cluster name. Accepted values: localnet, devnet, mainnet.
ANCHOR_CLUSTER=devnet

# Public COLS API base URL.
COLS_API_URL=https://cols-api.fly.dev

# Optional oracle authority pubkey override for testing.
COLS_ORACLE_PUBKEY=

# Optional admin authority pubkey override for testing.
COLS_ADMIN_PUBKEY=

# Optional fee basis points used by the init_config example. Range 0 to 10000.
COLS_FEE_BPS=300
